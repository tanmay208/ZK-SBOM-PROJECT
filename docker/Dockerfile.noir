FROM ubuntu:24.04

# Install basic dependencies
RUN apt-get update && apt-get install -y curl tar ca-certificates bash build-essential jq

# Pin Noir version for reproducibility
ENV NOIR_VERSION=v0.32.0
ENV NOIR_TAR=nargo-x86_64-unknown-linux-gnu.tar.gz

# Download and install Nargo
RUN curl -sL -O https://github.com/noir-lang/noir/releases/download/${NOIR_VERSION}/${NOIR_TAR} && \
    tar -xzf ${NOIR_TAR} && \
    install -m 0755 nargo /usr/local/bin/nargo && \
    rm -f nargo ${NOIR_TAR}

# Working directory for Noir projects
WORKDIR /workspace

# Verify installation
RUN nargo --version

ENTRYPOINT ["/bin/bash"]
