# ==============================================================================
# Local Development Environment Template (Disposable PostgreSQL Instance)
# Copy this file to .env.local_dev. Never commit .env.local_dev with active credentials.
# ==============================================================================

ENVIRONMENT=local_dev

# Target: Disposable Docker container zkp_sbom_local_dev (host-published port 5433)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ZKP_SBOM_LOCAL_DEV
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_LOCAL_DEV_DB_PASSWORD
DB_SSL_MODE=disable
DB_ECHO=false

# Local cryptographic profile (dev profile allows local mock/test vectors)
CRYPTO_PROFILE=dev

# Application secrets: Must be at least 32 characters, distinct, and non-trivial
JWT_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CERTIFICATE_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET
CERTIFICATE_ACTIVE_KID=v1
CERTIFICATE_SECRET_KEYS={"v1": "REPLACE_WITH_SAME_CERTIFICATE_SECRET_AS_ABOVE"}

LOG_LEVEL=INFO
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
