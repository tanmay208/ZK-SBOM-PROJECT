# Compose/backend template. Replace locally; never commit real values.
DB_DRIVER=postgresql+psycopg2
DB_HOST=REPLACE_WITH_REACHABLE_POSTGRES_HOST
DB_PORT=5432
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_SSL_MODE=require
DB_ECHO=false

# Set distinct, strong random values locally. Do not reuse either secret.
JWT_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CERTIFICATE_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
CRYPTO_PROFILE=prod
CORS_ORIGINS=http://localhost:3000

# Optional Next.js setting; place in frontend/.env.local for the frontend process.
NEXT_PUBLIC_API_URL=http://localhost:8000
